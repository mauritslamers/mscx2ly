{
  "name": "mscx2ly",
  "version": "0.1.12",
  "description": "Tool to render lilypond code from a MuseScore save file",
  "main": "index.js",
  "bin": {
    "mscx2ly": "bin/mscx2ly.js"
  },
  "files": [
    "bin",
    "render/*.js",
    "!render/*.test.js",
    "index.js",
    "lib.js",
    "xml_wrapper.js",
    "compat.js",
    "extract_lyric_timings.js",
    "typings"
  ],
  "scripts": {
    "test": "ava",
    "compare-pdf": "node scripts/compare-pdf.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mauritslamers/mscx2ly.git"
  },
  "keywords": [
    "lilypond",
    "musescore"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "typings": "./typings/mscx2ly.d.ts",
  "author": "Maurits Lamers",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mauritslamers/mscx2ly/issues"
  },
  "homepage": "https://github.com/mauritslamers/mscx2ly#readme",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "commander": "^12.1.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "ava": "^6.2.0"
  }
}
